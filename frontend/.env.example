# Copy to frontend/.env.local for local development. Every VITE_* value is compiled into
# the public JavaScript bundle, so never put secrets here.

# Base URL of the OpsDesk API. A relative path keeps the browser on one origin, which is
# what the refresh-token cookie expects. Use a full URL (https://api.example.com/api/v1)
# only when the API is on another origin; then add this app's origin to the API's
# CORS_ALLOWED_ORIGINS. public/config.js can override this at runtime (apiBaseUrl).
VITE_API_BASE_URL=/api/v1

# Dev server only: where `npm run dev` forwards /api requests.
VITE_DEV_API_PROXY_TARGET=http://localhost:8000
