# Copy to backend/.env for local development (read only when DJANGO_READ_DOT_ENV_FILE=true,
# which config.settings.dev turns on). In any deployed environment set these as real
# environment variables. Never commit real values.

# Which settings module to use: config.settings.dev | config.settings.prod | config.settings.test
DJANGO_SETTINGS_MODULE=config.settings.dev

# --- Core ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
APP_ENV=development
LOG_LEVEL=INFO
# json (default) or plain
LOG_FORMAT=json

# --- PostgreSQL ---
DATABASE_URL=postgres://opsdesk:opsdesk@localhost:5432/opsdesk
DB_CONN_MAX_AGE=60
DB_CONNECT_TIMEOUT=5
HEALTH_DB_TIMEOUT_MS=2000

# --- Redis (refresh-token store; Celery broker from M3) ---
REDIS_URL=redis://localhost:6379/0
REDIS_SOCKET_TIMEOUT=2

# --- JWT (must be identical on every API replica) ---
JWT_SIGNING_KEY=change-me-to-a-different-long-random-string
JWT_ALGORITHM=HS256
JWT_ISSUER=opsdesk
JWT_AUDIENCE=opsdesk-api
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7
REFRESH_TOKEN_KEY_PREFIX=opsdesk:refresh

# --- Refresh-token cookie ---
REFRESH_COOKIE_NAME=opsdesk_refresh
# true in any environment served over HTTPS
REFRESH_COOKIE_SECURE=false
# Lax works when frontend and API share a site (e.g. app.example.com + api.example.com)
REFRESH_COOKIE_SAMESITE=Lax
# e.g. .example.com to share the cookie across subdomains; leave empty for host-only
REFRESH_COOKIE_DOMAIN=

# --- CORS: comma-separated frontend origins allowed to call the API ---
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# --- Accounts ---
ALLOW_REGISTRATION=true

# --- Email ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=OpsDesk <no-reply@example.com>

# --- Production-only hardening ---
SECURE_SSL_REDIRECT=false
SECURE_HSTS_SECONDS=0
