# Copy to backend/.env for local development (read only when DJANGO_READ_DOT_ENV_FILE=true,
# which config.settings.dev turns on). In any deployed environment set these as real
# environment variables. Never commit real values.

# Which settings module to use: config.settings.dev | config.settings.prod | config.settings.test
DJANGO_SETTINGS_MODULE=config.settings.dev

# --- Core ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
APP_ENV=development
LOG_LEVEL=INFO
# json (default) or plain
LOG_FORMAT=json

# --- PostgreSQL ---
DATABASE_URL=postgres://opsdesk:opsdesk@localhost:5432/opsdesk
DB_CONN_MAX_AGE=60
DB_CONNECT_TIMEOUT=5
HEALTH_DB_TIMEOUT_MS=2000

# --- Redis (refresh-token store and Celery broker) ---
REDIS_URL=redis://localhost:6379/0
REDIS_SOCKET_TIMEOUT=2

# --- Celery (worker and Beat) ---
# Defaults to REDIS_URL; set to use a separate Redis database or instance for the broker.
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_WORKER_CONCURRENCY=4
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_WORKER_MAX_TASKS_PER_CHILD=500
CELERY_TASK_TIME_LIMIT=300
CELERY_TASK_SOFT_TIME_LIMIT=240
# Must be longer than the longest task plus its retry countdown.
CELERY_VISIBILITY_TIMEOUT=3600
# true runs tasks inline in the API process (local debugging only)
CELERY_TASK_ALWAYS_EAGER=false
CELERY_BEAT_SCHEDULE_FILENAME=/tmp/opsdesk-celerybeat-schedule
TASK_MAX_RETRIES=5
TASK_RETRY_BACKOFF_MAX=600
OUTBOX_SWEEP_INTERVAL_SECONDS=60
OUTBOX_RETRY_AFTER_SECONDS=60
SLA_CHECK_INTERVAL_SECONDS=60
REMINDER_CHECK_INTERVAL_SECONDS=300
# Daily reports at this hour (UTC); weekly reports at the same hour on Mondays.
REPORT_HOUR_UTC=7

# --- Worker / Beat liveness files (python -m opsdesk_tasks.healthcheck worker|beat) ---
WORKER_HEARTBEAT_FILE=/tmp/opsdesk-worker-heartbeat
WORKER_HEARTBEAT_INTERVAL=15
BEAT_HEARTBEAT_FILE=/tmp/opsdesk-beat-heartbeat

# --- Links in notification emails ---
FRONTEND_BASE_URL=http://localhost:5173

# --- JWT (must be identical on every API replica) ---
JWT_SIGNING_KEY=change-me-to-a-different-long-random-string
JWT_ALGORITHM=HS256
JWT_ISSUER=opsdesk
JWT_AUDIENCE=opsdesk-api
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7
REFRESH_TOKEN_KEY_PREFIX=opsdesk:refresh

# --- Refresh-token cookie ---
REFRESH_COOKIE_NAME=opsdesk_refresh
# true in any environment served over HTTPS
REFRESH_COOKIE_SECURE=false
# Lax works when frontend and API share a site (e.g. app.example.com + api.example.com)
REFRESH_COOKIE_SAMESITE=Lax
# e.g. .example.com to share the cookie across subdomains; leave empty for host-only
REFRESH_COOKIE_DOMAIN=

# --- Rate limits on sign-in endpoints (N/second|minute|hour|day) ---
THROTTLE_AUTH_LOGIN=20/minute
THROTTLE_AUTH_LOGIN_ACCOUNT=10/minute
THROTTLE_AUTH_REFRESH=120/minute
THROTTLE_AUTH_REGISTER=10/hour
THROTTLE_AUTH_PASSWORD=5/minute
# Trusted reverse proxies in front of the API (load balancer, ingress controller), so the
# client IP is read from X-Forwarded-For. Leave empty when clients connect directly.
NUM_PROXIES=
# Shared cache for rate-limit counters; defaults to REDIS_URL.
CACHE_URL=redis://localhost:6379/2

# --- CORS: comma-separated frontend origins allowed to call the API ---
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# --- Accounts ---
ALLOW_REGISTRATION=true

# --- Email ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=OpsDesk <no-reply@example.com>

# --- Production-only hardening ---
SECURE_SSL_REDIRECT=false
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
# Optional: sent as X-OpsDesk-Version on every response (handy during rolling updates).
APP_VERSION=
